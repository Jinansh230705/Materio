{
  "name": "materio",
  "version": "2.0.4",
  "description": "Materio - all in one place for all your study needs. read, discuss, contribute",
  "main": "main.js",
  "scripts": {
    "generate:oread-icons": "node scripts/generate-oread-icons-css.js",
    "vercel-dev": "node scripts/vercel dev",
    "build": "node scripts/bundle exec jekyll build && netlify build",
    "functions": "node scripts/netlify functions:serve --functions=api/v1",
    "minify-js": "uglifyjs assets/scripts/auth.js assets/scripts/login.js assets/scripts/signup.js assets/scripts/forgot-password.js assets/scripts/profile-management.js -o _site/assets/scripts/auth.min.js --source-map --compress --mangle",
    "optimize": "npm run minify-js && npm run copy-min",
    "copy-min": "shx cp _site/assets/scripts/auth.min.js _site/assets/scripts/auth.min.js.map public/js/"
  },
  "dependencies": {
    "@google-analytics/data": "^4.12.1",
    "@netlify/functions": "^3.1.10",
    "@octokit/rest": "^22.0.0",
    "@supabase/supabase-js": "^2.49.4",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.3.1",
    "bcryptjs": "^2.4.3",
    "crypto": "^1.0.1",
    "dotenv": "^16.5.0",
    "formidable": "^3.5.4",
    "fuse.js": "^7.1.0",
    "googleapis": "^134.0.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.0.0",
    "nodemailer": "^8.0.0",
    "razorpay": "^2.9.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "glob": "^10.5.0",
    "html-minifier-terser": "^7.2.0",
    "jest": "^30.2.0",
    "netlify-cli": "^23.11.0",
    "shx": "^0.3.4",
    "terser": "^5.42.0",
    "uglify-js": "^3.17.4"
  },
  "overrides": {
    "js-yaml": "^4.1.1"
  }
}
